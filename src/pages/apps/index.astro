---
import BaseLayout from "@layouts/BaseLayout.astro";

// Interactive science modules, currently hosted on Atlas (atlas.ionialabs.com).
// These will be embedded natively into the site over time; for now each card
// launches the standalone module, which renders fine in a normal browser.
const ATLAS_BASE = "https://atlas.ionialabs.com/mini";

type Category = "biology" | "math" | "physics" | "chemistry";

interface Module {
  slug: string;
  title: string;
  description: string;
  tags: Category[];
  series?: string;
  part?: number;
}

const modules: Module[] = [
  {
    slug: "genetic-variation",
    title: "Genetic Variation",
    description:
      "Start with identical genomes and watch mutation plus recombination generate diversity before selection begins.",
    tags: ["biology", "math"],
    series: "Evolution",
    part: 1,
  },
  {
    slug: "natural-selection",
    title: "Natural Selection",
    description:
      "Apply climate pressure to evolving genomes and see adaptation, population collapse, or extinction play out.",
    tags: ["biology", "math"],
    series: "Evolution",
    part: 2,
  },
  {
    slug: "speciation",
    title: "Speciation",
    description:
      "Cut off gene flow with a wall and watch one population drift into two separate species over time.",
    tags: ["biology", "math"],
    series: "Evolution",
    part: 3,
  },
  {
    slug: "turing-patterns",
    title: "Turing Patterns",
    description:
      "See how simple chemical reactions create the complex patterns found in nature — from zebra stripes to leopard spots.",
    tags: ["biology", "chemistry", "math"],
  },
  {
    slug: "elliptic-keys",
    title: "Elliptic Keys",
    description:
      "Visualize elliptic-curve point addition and doubling — the math behind Bitcoin and modern encryption.",
    tags: ["math"],
  },
  {
    slug: "retrograde-motion",
    title: "Retrograde Motion",
    description:
      "See why Mars, Jupiter, and Saturn appear to reverse against the stars as Earth overtakes them.",
    tags: ["physics"],
  },
];

const categoryClasses: Record<Category, string> = {
  biology:
    "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300",
  math: "bg-violet-500/10 text-violet-700 dark:text-violet-300",
  physics: "bg-sky-500/10 text-sky-700 dark:text-sky-300",
  chemistry: "bg-amber-500/10 text-amber-700 dark:text-amber-300",
};
---

<BaseLayout
  title="Apps – Interactive science modules"
  description="Hands-on interactive science simulations from IoniaScience — explore evolution, patterns in nature, cryptography, and the motion of the planets."
>
  <section class="site-container pt-32 pb-12 md:pt-40">
    <div class="max-w-3xl">
      <p class="colored-title">Apps</p>
      <h1 class="h1 mt-6">Interactive science modules</h1>
      <p class="description mt-6 max-w-2xl text-lg">
        Hands-on simulations that let you play with the ideas behind the science — a companion to the
        blog's shorter reads. Each module runs right in your browser; drag the controls and watch what
        happens.
      </p>
    </div>
  </section>

  <section class="site-container pb-20 md:pb-28">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        modules.map((mod) => (
          <a
            href={`${ATLAS_BASE}/${mod.slug}`}
            target="_blank"
            rel="noopener"
            class="group flex flex-col rounded-2xl border border-black/10 p-6 transition hover:border-black/20 hover:bg-black/[0.02] dark:border-white/10 dark:hover:border-white/20 dark:hover:bg-white/[0.03]"
          >
            {mod.series && (
              <p class="colored-title mb-2 text-xs">
                {mod.series} · Part {mod.part}
              </p>
            )}
            <h2 class="text-xl font-semibold">{mod.title}</h2>
            <p class="description mt-3 grow text-base">{mod.description}</p>
            <div class="mt-5 flex flex-wrap items-center gap-2">
              {mod.tags.map((tag) => (
                <span
                  class={`rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ${categoryClasses[tag]}`}
                >
                  {tag}
                </span>
              ))}
            </div>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium opacity-80 transition group-hover:opacity-100">
              Launch module
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <p class="description mt-10 max-w-2xl text-sm opacity-70">
      Modules currently open on <a href="https://atlas.ionialabs.com" target="_blank" rel="noopener" class="underline underline-offset-2">Atlas</a>,
      our interactive-simulation project. They'll be woven directly into IoniaScience over time.
    </p>
  </section>
</BaseLayout>
